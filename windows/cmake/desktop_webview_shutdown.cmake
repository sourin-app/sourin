# desktop_webview_window 0.4.0 unregisters a channel from its destructor.
# Flutter invalidates the native messenger before destroying plugin registrars.
# Build a corrected copy without changing the shared Pub cache.
function(sourin_fix_desktop_webview_shutdown)
  set(plugin desktop_webview_window_plugin)
  get_target_property(plugin_dir ${plugin} SOURCE_DIR)
  get_target_property(sources ${plugin} SOURCES)
  set(original "${plugin_dir}/web_view_window_plugin.cc")
  file(READ "${original}" source)
  string(REPLACE "\r\n" "\n" source "${source}")
  set(before "WebviewWindowPlugin::~WebviewWindowPlugin() {\n  channel_->SetMethodCallHandler(nullptr);")
  set(after "WebviewWindowPlugin::~WebviewWindowPlugin() {\n  // The engine messenger is already invalid during registrar destruction.\n  // The registrar releases the handler with its BinaryMessenger; do not\n  // unregister it through the stopped engine here.")
  string(FIND "${source}" "${before}" position)
  if(position EQUAL -1)
    message(FATAL_ERROR "desktop_webview_window shutdown source changed; review the compatibility fix")
  endif()
  string(REPLACE "${before}" "${after}" source "${source}")
  set(patched "${CMAKE_CURRENT_BINARY_DIR}/sourin_plugin_fixes/web_view_window_plugin.cc")
  file(MAKE_DIRECTORY "${CMAKE_CURRENT_BINARY_DIR}/sourin_plugin_fixes")
  file(WRITE "${patched}.in" "${source}")
  configure_file("${patched}.in" "${patched}" COPYONLY)
  set(updated)
  set(replaced FALSE)
  foreach(item IN LISTS sources)
    if(NOT IS_ABSOLUTE "${item}" AND NOT item MATCHES "^\\$<")
      set(item "${plugin_dir}/${item}")
    endif()
    if(item STREQUAL original)
      list(APPEND updated "${patched}")
      set(replaced TRUE)
    else()
      list(APPEND updated "${item}")
    endif()
  endforeach()
  if(NOT replaced)
    message(FATAL_ERROR "desktop_webview_window source list changed; review the compatibility fix")
  endif()
  set_property(TARGET ${plugin} PROPERTY SOURCES "${updated}")
  target_include_directories(${plugin} PRIVATE "${plugin_dir}")
  set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${original}")
endfunction()

sourin_fix_desktop_webview_shutdown()
