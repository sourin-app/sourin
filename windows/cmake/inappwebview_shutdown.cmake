# InAppWebView 0.6.0 keeps composition objects in process statics. Release them
# with the final manager, before the main thread and DLL start shutting down.
function(sourin_fix_inappwebview_shutdown)
  set(plugin flutter_inappwebview_windows_plugin)
  get_target_property(plugin_dir ${plugin} SOURCE_DIR)
  get_target_property(sources ${plugin} SOURCES)
  set(original "${plugin_dir}/in_app_webview/in_app_webview_manager.cpp")
  file(READ "${original}" source)
  string(REPLACE "\r\n" "\n" source "${source}")
  set(before "namespace flutter_inappwebview_plugin\n{")
  set(after "namespace flutter_inappwebview_plugin\n{\n  namespace { unsigned live_managers = 0; }")
  string(FIND "${source}" "${before}" position)
  if(position EQUAL -1)
    message(FATAL_ERROR "InAppWebView manager namespace changed; review shutdown fix")
  endif()
  string(REPLACE "${before}" "${after}" source "${source}")
  set(before "    if (!rohelper_) {")
  set(after "    ++live_managers;\n    if (!rohelper_) {")
  string(FIND "${source}" "${before}" position)
  if(position EQUAL -1)
    message(FATAL_ERROR "InAppWebView manager initialization changed; review shutdown fix")
  endif()
  string(REPLACE "${before}" "${after}" source "${source}")
  set(before "    UnregisterClass(windowClass_.lpszClassName, nullptr);\n    plugin = nullptr;")
  set(after "    UnregisterClass(windowClass_.lpszClassName, nullptr);\n    plugin = nullptr;\n    if (--live_managers == 0) {\n      // Release WinRT objects on their owning thread before DLL detach.\n      compositor_ = nullptr;\n      graphics_context_.reset();\n      dispatcher_queue_controller_ = nullptr;\n      rohelper_.reset();\n      valid_ = false;\n    }")
  string(FIND "${source}" "${before}" position)
  if(position EQUAL -1)
    message(FATAL_ERROR "InAppWebView manager destruction changed; review shutdown fix")
  endif()
  string(REPLACE "${before}" "${after}" source "${source}")
  set(patched "${CMAKE_CURRENT_BINARY_DIR}/sourin_plugin_fixes/in_app_webview_manager.cpp")
  file(MAKE_DIRECTORY "${CMAKE_CURRENT_BINARY_DIR}/sourin_plugin_fixes")
  file(WRITE "${patched}.in" "${source}")
  configure_file("${patched}.in" "${patched}" COPYONLY)
  set(updated)
  set(replaced FALSE)
  foreach(item IN LISTS sources)
    if(NOT IS_ABSOLUTE "${item}" AND NOT item MATCHES "^\\$<")
      set(item "${plugin_dir}/${item}")
    endif()
    if(item STREQUAL original)
      list(APPEND updated "${patched}")
      set(replaced TRUE)
    else()
      list(APPEND updated "${item}")
    endif()
  endforeach()
  if(NOT replaced)
    message(FATAL_ERROR "InAppWebView source list changed; review shutdown fix")
  endif()
  set_property(TARGET ${plugin} PROPERTY SOURCES "${updated}")
  target_include_directories(${plugin} PRIVATE "${plugin_dir}/in_app_webview")
  set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${original}")
endfunction()

sourin_fix_inappwebview_shutdown()
