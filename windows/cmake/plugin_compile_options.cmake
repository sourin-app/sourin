# Preserve plugin-owned exception/warning policy with clang-cl.
# Call after generated_plugins.cmake. No shared Pub cache files are changed.
if(NOT CMAKE_CXX_COMPILER_ID STREQUAL "Clang")
  return()
endif()

function(sourin_fix_plugin_compile_options)
  set(selector file_selector_windows_plugin)
  set(inapp flutter_inappwebview_windows_plugin)
  if(NOT TARGET ${selector} OR NOT TARGET ${inapp})
    message(FATAL_ERROR "Windows plugin targets changed; review Clang option compatibility")
  endif()
  get_target_property(selector_dir ${selector} SOURCE_DIR)
  get_target_property(inapp_dir ${inapp} SOURCE_DIR)
  file(SHA256 "${selector_dir}/CMakeLists.txt" selector_hash)
  file(SHA256 "${inapp_dir}/CMakeLists.txt" inapp_hash)
  if(NOT selector_hash STREQUAL "a233e689aea9f7962ee635e02b68d7db3b0903fb5fb854898ecec400d7931a82"
      OR NOT inapp_hash STREQUAL "73cfabae0fa0cbd346a5c7d605eebe1b1dee56e1878a7dfe84a72a0ad71d7f94")
    message(FATAL_ERROR "Windows plugin compiler policy changed; review Clang option compatibility")
  endif()

  # The plugin explicitly enables exceptions for std::any after calling the
  # application's default settings. Keep that override as the only definition.
  foreach(target IN ITEMS file_selector_windows_plugin file_selector_windows_test)
    if(NOT TARGET ${target})
      continue()
    endif()
    get_target_property(definitions ${target} COMPILE_DEFINITIONS)
    set(updated)
    set(disabled_count 0)
    set(enabled_count 0)
    foreach(definition IN LISTS definitions)
      if(definition STREQUAL "_HAS_EXCEPTIONS=0")
        math(EXPR disabled_count "${disabled_count} + 1")
      else()
        if(definition STREQUAL "_HAS_EXCEPTIONS=1")
          math(EXPR enabled_count "${enabled_count} + 1")
        endif()
        list(APPEND updated "${definition}")
      endif()
    endforeach()
    if(NOT disabled_count EQUAL 1 OR NOT enabled_count EQUAL 1)
      message(FATAL_ERROR "file_selector exception definitions changed; review Clang option compatibility")
    endif()
    set_property(TARGET ${target} PROPERTY COMPILE_DEFINITIONS "${updated}")
  endforeach()

  # Normalize the existing 4100 exception only; keep the plugin's /W4 policy.
  # This plugin intentionally owns a settings function without /WX upstream.
  get_target_property(options ${inapp} COMPILE_OPTIONS)
  set(updated)
  set(quoted_count 0)
  foreach(option IN LISTS options)
    if(option STREQUAL [=[/wd"4100"]=])
      list(APPEND updated "/wd4100")
      math(EXPR quoted_count "${quoted_count} + 1")
    else()
      list(APPEND updated "${option}")
    endif()
  endforeach()
  if(NOT quoted_count EQUAL 1)
    message(FATAL_ERROR "InAppWebView warning option changed; review Clang option compatibility")
  endif()
  set_property(TARGET ${inapp} PROPERTY COMPILE_OPTIONS "${updated}")
  set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS
    "${selector_dir}/CMakeLists.txt" "${inapp_dir}/CMakeLists.txt")
endfunction()

sourin_fix_plugin_compile_options()
