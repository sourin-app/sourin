# Build-time materialization only. Existing dependency target owns NuGet restore.
cmake_minimum_required(VERSION 3.14)
foreach(required SOURIN_SDK_BUILD_ROOT SOURIN_SDK_ORIGIN SOURIN_SDK_DESTINATION)
  if(NOT DEFINED ${required} OR "${${required}}" STREQUAL "")
    message(FATAL_ERROR "Missing InAppWebView SDK generation argument: ${required}")
  endif()
endforeach()
get_filename_component(build_root "${SOURIN_SDK_BUILD_ROOT}" REALPATH)
get_filename_component(origin "${SOURIN_SDK_ORIGIN}" ABSOLUTE)
get_filename_component(destination "${SOURIN_SDK_DESTINATION}" ABSOLUTE)
set(expected_origin "${build_root}/packages/Microsoft.Web.WebView2/build/native/include")
set(expected_destination "${build_root}/sourin_plugin_fixes/inappwebview_clang/webview2")
if(NOT origin STREQUAL expected_origin OR NOT destination STREQUAL expected_destination)
  message(FATAL_ERROR "InAppWebView SDK generation paths differ from owned build paths")
endif()
if(NOT IS_DIRECTORY "${origin}" OR IS_SYMLINK "${origin}")
  message(FATAL_ERROR "Existing NuGet dependency target did not produce the SDK include directory")
endif()
file(MAKE_DIRECTORY "${destination}")
get_filename_component(resolved_destination "${destination}" REALPATH)
if(NOT resolved_destination STREQUAL expected_destination)
  message(FATAL_ERROR "InAppWebView SDK output resolves outside the owned directory")
endif()
# The pinned 1.0.2792.45 SDK include tree contains exactly these two headers.
file(GLOB_RECURSE header_inputs RELATIVE "${origin}" LIST_DIRECTORIES FALSE "${origin}/*")
list(SORT header_inputs)
set(expected_headers "WebView2.h;WebView2EnvironmentOptions.h")
if(NOT header_inputs STREQUAL expected_headers)
  message(FATAL_ERROR "InAppWebView SDK include inventory changed; review private materialization")
endif()
foreach(relative IN LISTS header_inputs)
  if(IS_SYMLINK "${origin}/${relative}")
    message(FATAL_ERROR "InAppWebView SDK header must not be a symlink")
  endif()
endforeach()
include("${CMAKE_CURRENT_LIST_DIR}/inappwebview_clang_core.cmake")
  set(input "${origin}/WebView2.h")
  set(output "${destination}/WebView2.h")
  file(SHA256 "${input}" digest)
  if(NOT digest STREQUAL "78a70f7ff050bfecfc7a46e242195fc1bcf36551c9b7873881218c729dba97f0")
    message(FATAL_ERROR "InAppWebView compatibility input changed: WebView2.h")
  endif()
  file(READ "${input}" source)
  string(REPLACE "\r\n" "\n" source "${source}")
  set(before [====[        COREWEBVIEW2_RELEASE_CHANNELS_CANARY	= 0x8
]====])
  set(after [====[        COREWEBVIEW2_RELEASE_CHANNELS_CANARY	= 0x8,
        COREWEBVIEW2_RELEASE_CHANNELS_SOURIN_INTERNAL_COMPAT = 0x10
]====])
  sourin_inapp_replace_once(source before after)
  string(SHA256 normalized_hash "${source}")
  if(NOT normalized_hash STREQUAL "a01932279d55d01131c6a622ba3e95112575d4f6d4349b18c08910deb88dc22c")
    message(FATAL_ERROR "Private InAppWebView SDK normalized result differs from reviewed bytes")
  endif()
  # Stage deterministic bytes, copy only when final bytes differ, then remove no files.
  file(WRITE "${output}.in" "${source}")
  configure_file("${output}.in" "${output}" COPYONLY)
  set(input "${origin}/WebView2EnvironmentOptions.h")
  set(output "${destination}/WebView2EnvironmentOptions.h")
  file(SHA256 "${input}" digest)
  if(NOT digest STREQUAL "67457286dc5002634b3936e371b8cff358336a52c4ec30cbd4a691a7e2905415")
    message(FATAL_ERROR "InAppWebView compatibility input changed: WebView2EnvironmentOptions.h")
  endif()
  file(READ "${input}" source)
  string(REPLACE "\r\n" "\n" source "${source}")
  set(before [====[#include "webview2.h"]====])
  set(after [====[#include "WebView2.h"]====])
  sourin_inapp_replace_once(source before after)
  string(SHA256 normalized_hash "${source}")
  if(NOT normalized_hash STREQUAL "e1023d75a16d4736dee5e9562768e4a1e1efb11c94d83313703091e2aae963f0")
    message(FATAL_ERROR "Private InAppWebView SDK normalized result differs from reviewed bytes")
  endif()
  # Stage deterministic bytes, copy only when final bytes differ, then remove no files.
  file(WRITE "${output}.in" "${source}")
  configure_file("${output}.in" "${output}" COPYONLY)
file(SHA256 "${destination}/WebView2.h" generated_webview_hash)
file(SHA256 "${destination}/WebView2EnvironmentOptions.h" generated_options_hash)
set(receipt "{\n  \"schema\": 1,\n  \"webviewRawSha256\": \"${generated_webview_hash}\",\n  \"optionsRawSha256\": \"${generated_options_hash}\"\n}\n")
file(WRITE "${destination}/generation-receipt.json.in" "${receipt}")
configure_file("${destination}/generation-receipt.json.in" "${destination}/generation-receipt.json" COPYONLY)
