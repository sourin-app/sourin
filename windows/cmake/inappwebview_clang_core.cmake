# Configure-time source compatibility after copying the complete plugin tree.
# SDK materialization runs later through inappwebview_clang_sdk.cmake.
# Parent owns source/include rebinding and the already-patched shutdown TU override.
function(sourin_inapp_replace_once variable before_variable after_variable)
  set(value "${${variable}}")
  set(before "${${before_variable}}")
  set(after "${${after_variable}}")
  string(FIND "${value}" "${before}" position)
  if(position EQUAL -1)
    message(FATAL_ERROR "InAppWebView compatibility anchor missing")
  endif()
  string(LENGTH "${before}" before_length)
  math(EXPR tail_start "${position} + ${before_length}")
  string(SUBSTRING "${value}" ${tail_start} -1 tail)
  string(FIND "${tail}" "${before}" duplicate)
  if(NOT duplicate EQUAL -1)
    message(FATAL_ERROR "InAppWebView compatibility anchor duplicated")
  endif()
  string(REPLACE "${before}" "${after}" value "${value}")
  set(${variable} "${value}" PARENT_SCOPE)
endfunction()

function(sourin_apply_inapp_core_compatibility plugin private_plugin_dir)
  if(NOT TARGET ${plugin})
    message(FATAL_ERROR "InAppWebView compatibility target missing")
  endif()
  get_filename_component(owned_root "${CMAKE_CURRENT_BINARY_DIR}/sourin_plugin_fixes" REALPATH)
  foreach(private_dir IN ITEMS "${private_plugin_dir}")
    if(NOT IS_DIRECTORY "${private_dir}")
      message(FATAL_ERROR "InAppWebView private tree must be copied before applying compatibility edits")
    endif()
    get_filename_component(resolved "${private_dir}" REALPATH)
    file(RELATIVE_PATH relative "${owned_root}" "${resolved}")
    string(FIND "${relative}" "../" parent_prefix)
    if(relative STREQUAL "" OR relative STREQUAL ".." OR parent_prefix EQUAL 0
        OR IS_ABSOLUTE "${relative}")
      message(FATAL_ERROR "InAppWebView compatibility writes must stay in generated private trees")
    endif()
  endforeach()
  # Avoid the unsupported MSVC experimental coroutine path without masking its error.
  target_compile_features(${plugin} PRIVATE cxx_std_20)
  set(input "${private_plugin_dir}/utils/util.h")
  file(SHA256 "${input}" digest)
  if(NOT digest STREQUAL "2d255e67591835935c0a69028359dc1b28f396439e3dee86533d6e8e07a7dcd4")
    message(FATAL_ERROR "InAppWebView compatibility input changed: util.h")
  endif()
  file(READ "${input}" source)
  string(REPLACE "\r\n" "\n" source "${source}")
  set(before [====[#include <string>
]====])
  set(after [====[#include <string>
#include <type_traits>
]====])
  sourin_inapp_replace_once(source before after)
  set(before [====[static_assert(always_false_v<T>, "non-exhaustive visitor!");]====])
  set(after [====[static_assert(!std::is_same_v<T, T>, "non-exhaustive visitor!");]====])
  sourin_inapp_replace_once(source before after)
  file(WRITE "${input}.in" "${source}")
  configure_file("${input}.in" "${input}" COPYONLY)
endfunction()
